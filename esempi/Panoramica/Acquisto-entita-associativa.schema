    "draft": "-- Database Schema Studio 0.9.2 | HSQLDB 1.8 / LibreOffice Base\n-- Controlli statici superati; questo script non è stato eseguito dall'app.\n-- Usa uno schema HSQLDB esistente e vuoto. Lo script non crea un file .odb. In Base: Strumenti → SQL, una istruzione alla volta; poi aggiorna le tabelle.\n\nSET PROPERTY \"sql.enforce_strict_size\" TRUE;\n\nCREATE TABLE \"PUBLIC\".\"Persona\" (\n    \"CodiceFiscale\" VARCHAR(100) NOT NULL,\n    \"Nome\" VARCHAR(100),\n    CONSTRAINT \"PK_3920a7a08519d7a14df8bdda\" PRIMARY KEY (\"CodiceFiscale\")\n);\n\nCREATE TABLE \"PUBLIC\".\"Acquisto\" (\n    \"IdAcquisto\" INTEGER NOT NULL,\n    \"DataAcquisto\" DATE,\n    \"PrezzoAcquisto\" DECIMAL(19,4),\n    \"Targa\" VARCHAR(100),\n    \"Persona_CodiceFiscale\" VARCHAR(100) NOT NULL,\n    \"ModelloAuto_CodiceModello\" VARCHAR(100) NOT NULL,\n    CONSTRAINT \"PK_127344c1c9d7edd3cb4bc74c\" PRIMARY KEY (\"IdAcquisto\")\n);\n\nCREATE TABLE \"PUBLIC\".\"ModelloAuto\" (\n    \"CodiceModello\" VARCHAR(100) NOT NULL,\n    \"Descrizione\" VARCHAR(100),\n    CONSTRAINT \"PK_422e2853ca2d706ec166ee35\" PRIMARY KEY (\"CodiceModello\")\n);\n\nALTER TABLE \"PUBLIC\".\"Acquisto\" ADD CONSTRAINT \"FK_239d990ff80e9ac64c0fbc01\" FOREIGN KEY (\"Persona_CodiceFiscale\") REFERENCES \"PUBLIC\".\"Persona\" (\"CodiceFiscale\");\n\nALTER TABLE \"PUBLIC\".\"Acquisto\" ADD CONSTRAINT \"FK_30939578e3c1c878c9252427\" FOREIGN KEY (\"ModelloAuto_CodiceModello\") REFERENCES \"PUBLIC\".\"ModelloAuto\" (\"CodiceModello\");\n",
