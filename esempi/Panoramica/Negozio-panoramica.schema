    "draft": "-- Database Schema Studio 0.9.2 | HSQLDB 1.8 / LibreOffice Base\n-- Controlli statici superati; questo script non è stato eseguito dall'app.\n-- Usa uno schema HSQLDB esistente e vuoto. Lo script non crea un file .odb. In Base: Strumenti → SQL, una istruzione alla volta; poi aggiorna le tabelle.\n-- La partecipazione minima del proprietario in Contiene richiede un controllo aggiuntivo oltre a PK/FK.\n\nSET PROPERTY \"sql.enforce_strict_size\" TRUE;\n\nCREATE TABLE \"PUBLIC\".\"Privato\" (\n    \"CodiceFiscale\" VARCHAR(100) NOT NULL,\n    \"Cliente_IdCliente\" INTEGER NOT NULL,\n    CONSTRAINT \"PK_b56fe2bcc0ed9774b30c3027\" PRIMARY KEY (\"Cliente_IdCliente\"),\n    CONSTRAINT \"UQ_1886ebf9157ffbc1b21b6618\" UNIQUE (\"CodiceFiscale\")\n);\n\nCREATE TABLE \"PUBLIC\".\"Azienda\" (\n    \"PartitaIVA\" VARCHAR(100) NOT NULL,\n    \"Cliente_IdCliente\" INTEGER NOT NULL,\n    CONSTRAINT \"PK_91970229ce5c0c93e1580e2a\" PRIMARY KEY (\"Cliente_IdCliente\"),\n    CONSTRAINT \"UQ_132cf3bd8cffe4d3d846ed4c\" UNIQUE (\"PartitaIVA\")\n);\n\nCREATE TABLE \"PUBLIC\".\"Cliente\" (\n    \"IdCliente\" INTEGER NOT NULL,\n    \"Nome\" VARCHAR(100),\n    \"Attivo\" BOOLEAN,\n    CONSTRAINT \"PK_cb9153c67e056af65cad00a6\" PRIMARY KEY (\"IdCliente\")\n);\n\nCREATE TABLE \"PUBLIC\".\"Ordine\" (\n    \"IdOrdine\" INTEGER NOT NULL,\n    \"DataOrdine\" DATE,\n    \"Cliente_IdCliente\" INTEGER NOT NULL,\n    CONSTRAINT \"PK_aafb0463a7cdccbe2c377fa0\" PRIMARY KEY (\"IdOrdine\")\n);\n\nCREATE TABLE \"PUBLIC\".\"Fattura\" (\n    \"NumeroFattura\" VARCHAR(100) NOT NULL,\n    \"DataEmissione\" DATE,\n    \"Ordine_IdOrdine\" INTEGER NOT NULL,\n    CONSTRAINT \"PK_b7f1067a99adfddef490f2a4\" PRIMARY KEY (\"NumeroFattura\"),\n    CONSTRAINT \"UQ_91c1e5714a96c2df71292ff7\" UNIQUE (\"Ordine_IdOrdine\")\n);\n\nCREATE TABLE \"PUBLIC\".\"RigaOrdine\" (\n    \"NumeroRiga\" INTEGER NOT NULL,\n    \"Quantita\" INTEGER,\n    \"PrezzoUnitario\" DECIMAL(19,4),\n    \"Ordine_IdOrdine\" INTEGER NOT NULL,\n    \"Prodotto_IdProdotto\" INTEGER NOT NULL,\n    CONSTRAINT \"PK_dfc6863533066f3cdbf76eb1\" PRIMARY KEY (\"NumeroRiga\", \"Ordine_IdOrdine\")\n);\n\nCREATE TABLE \"PUBLIC\".\"Prodotto\" (\n    \"IdProdotto\" INTEGER NOT NULL,\n    \"Descrizione\" VARCHAR(100),\n    \"PesoKg\" DOUBLE,\n    CONSTRAINT \"PK_46266a4f62595197f7dbfd43\" PRIMARY KEY (\"IdProdotto\")\n);\n\nCREATE TABLE \"PUBLIC\".\"Categoria\" (\n    \"IdCategoria\" INTEGER NOT NULL,\n    \"Denominazione\" VARCHAR(100),\n    \"superiore_IdCategoria\" INTEGER,\n    CONSTRAINT \"PK_65e72fe2392c0bcc84fb1a28\" PRIMARY KEY (\"IdCategoria\")\n);\n\nCREATE TABLE \"PUBLIC\".\"Classificazione\" (\n    \"Prodotto_IdProdotto\" INTEGER NOT NULL,\n    \"Categoria_IdCategoria\" INTEGER NOT NULL,\n    CONSTRAINT \"PK_63bff59b450b42e607e97b03\" PRIMARY KEY (\"Prodotto_IdProdotto\", \"Categoria_IdCategoria\")\n);\n\nALTER TABLE \"PUBLIC\".\"Privato\" ADD CONSTRAINT \"FK_b312c69a4a2eb8dd30b00e7f\" FOREIGN KEY (\"Cliente_IdCliente\") REFERENCES \"PUBLIC\".\"Cliente\" (\"IdCliente\");\n\nALTER TABLE \"PUBLIC\".\"Azienda\" ADD CONSTRAINT \"FK_ed9c86ed07ada9280a0c72b9\" FOREIGN KEY (\"Cliente_IdCliente\") REFERENCES \"PUBLIC\".\"Cliente\" (\"IdCliente\");\n\nALTER TABLE \"PUBLIC\".\"Ordine\" ADD CONSTRAINT \"FK_239d990ff80e9ac64c0fbc01\" FOREIGN KEY (\"Cliente_IdCliente\") REFERENCES \"PUBLIC\".\"Cliente\" (\"IdCliente\");\n\nALTER TABLE \"PUBLIC\".\"Fattura\" ADD CONSTRAINT \"FK_577f53b8eb39bc9483f47cbc\" FOREIGN KEY (\"Ordine_IdOrdine\") REFERENCES \"PUBLIC\".\"Ordine\" (\"IdOrdine\");\n\nALTER TABLE \"PUBLIC\".\"RigaOrdine\" ADD CONSTRAINT \"FK_18ee5e61c535696ab4910299\" FOREIGN KEY (\"Ordine_IdOrdine\") REFERENCES \"PUBLIC\".\"Ordine\" (\"IdOrdine\");\n\nALTER TABLE \"PUBLIC\".\"RigaOrdine\" ADD CONSTRAINT \"FK_64bf5908410e5b63c8b26d3f\" FOREIGN KEY (\"Prodotto_IdProdotto\") REFERENCES \"PUBLIC\".\"Prodotto\" (\"IdProdotto\");\n\nALTER TABLE \"PUBLIC\".\"Categoria\" ADD CONSTRAINT \"FK_b94657d59727eabf9f242be9\" FOREIG