      },
      {
        "en": "Local identifiers of Privato become an alternate UNIQUE key; the PK is inherited.",
        "it": "Gli identificatori locali di Privato diventano una chiave alternativa UNIQUE; la PK è ereditata.",
        "source": "isa_privato",
        "warning": false
      },
      {
        "en": "ISA: Privato keeps its table with a PK that is also an FK to Cliente.",
        "it": "ISA: Privato mantiene la propria tabella con PK anche FK verso Cliente.",
        "source": "isa_privato",
        "warning": false
      },
      {
        "en": "Local identifiers of Azienda become an alternate UNIQUE key; the PK is inherited.",
        "it": "Gli identificatori locali di Azienda diventano una chiave alternativa UNIQUE; la PK è ereditata.",
        "source": "isa_azienda",
        "warning": false
      },
      {
        "en": "ISA: Azienda keeps its table with a PK that is also an FK to Cliente.",
        "it": "ISA: Azienda mantiene la propria tabella con PK anche FK verso Cliente.",
        "source": "isa_azienda",
        "warning": false
      },
      {
        "en": "Weak entity RigaOrdine: PK = partial keys + Ordine PK; the inherited part is also an FK.",
        "it": "Entità debole RigaOrdine: PK = componenti della chiave parziale + PK di Ordine; la parte ereditata è anche FK.",
        "source": "contiene",
        "warning": false
      },
      {
        "en": "Minimum owner participation in Contiene requires an additional check beyond PK/FK.",
        "it": "La partecipazione minima del proprietario in Contiene richiede un controllo aggiuntivo oltre a PK/FK.",
        "source": "contiene",
        "warning": true
      },
      {
        "en": "Effettua: FK in Ordine referencing Cliente (1:N).",
        "it": "Effettua: FK in Ordine verso Cliente (1:N).",
        "source": "effettua",
        "warning": false
      },
      {
        "en": "DocumentatoDa: FK in Fattura referencing Ordine (1:1, FK with UNIQUE constraint).",
        "it": "DocumentatoDa: FK in Fattura verso Ordine (1:1, FK con vincolo UNIQUE).",
        "source": "documenta",
        "warning": false
      },
      {
        "en": "Riguarda: FK in RigaOrdine referencing Prodotto (1:N).",
        "it": "Riguarda: FK in RigaOrdine verso Prodotto (1:N).",
        "source": "riferisce",
        "warning": false
      },
      {
        "en": "Classificazione: M:N → junction table with two FKs and their union as the composite PK.",
        "it": "Classificazione: N:M → tabella di collegamento con le due FK e PK composta dalla loro unione.",
        "source": "classifica",
        "warning": false
      },
      {
        "en": "Comprende: FK in Categoria referencing Categoria (1:N).",
        "it": "Comprende: FK in Categoria verso Categoria (1:N).",
        "source": "gerarchia",
        "warning": false
      }
    ],
