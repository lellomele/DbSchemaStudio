    "draft": "-- Database Schema Studio 0.9.1 | HSQLDB 1.8 / LibreOffice Base\n-- Controlli statici superati; questo script non è stato eseguito dall'app.\n-- Usa uno schema HSQLDB esistente e vuoto. Lo script non crea un file .odb. In Base: Strumenti → SQL, una istruzione alla volta; poi aggiorna le tabelle.\n\nSET PROPERTY \"sql.enforce_strict_size\" TRUE;\n\nCREATE TABLE \"PUBLIC\".\"Ordine\" (\n    \"NumeroOrdine\" INTEGER GENERATED BY DEFAULT AS IDENTITY (START WITH 10),\n    \"Data\" DATE\n);\n\nCREATE TABLE \"PUBLIC\".\"RigaOrdine\" (\n    \"NumeroRiga\" INTEGER NOT NULL,\n    \"Quantita\" INTEGER,\n    \"ordine_NumeroOrdine\" INTEGER NOT NULL,\n    CONSTRAINT \"PK_dfc6863533066f3cdbf76eb1\" PRIMARY KEY (\"NumeroRiga\", \"ordine_NumeroOrdine\")\n);\n\nALTER TABLE \"PUBLIC\".\"RigaOrdine\" ADD CONSTRAINT \"FK_18ee5e61c535696ab4910299\" FOREIGN KEY (\"ordine_NumeroOrdine\") REFERENCES \"PUBLIC\".\"Ordine\" (\"NumeroOrdine\");\n",
