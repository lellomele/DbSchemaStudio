    "generatedText": "-- Database Schema Studio 0.9.1 | MariaDB 10.11\n-- Controlli statici superati; questo script non è stato eseguito dall'app.\n-- InnoDB, utf8mb4, fuso UTC e modalità SQL rigorosa per la connessione corrente. Mantieni la modalità rigorosa anche nelle connessioni usate per inserire dati. Esegui l'intero script in una sola connessione, su un database vuoto.\n\nSET NAMES utf8mb4;\n\nSET SESSION time_zone = '+00:00';\n\nSET SESSION sql_mode = 'STRICT_ALL_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION,NO_BACKSLASH_ESCAPES';\n\nCREATE DATABASE `database_esempio` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;\n\nCREATE TABLE `database_esempio`.`Ordine` (\n    `NumeroOrdine` INTEGER NOT NULL AUTO_INCREMENT,\n    `Data` DATE NULL,\n    CONSTRAINT `PK_aafb0463a7cdccbe2c377fa0` PRIMARY KEY (`NumeroOrdine`)\n) ENGINE=InnoDB ROW_FORMAT=DYNAMIC DEFAULT CHARACTER SET=utf8mb4 COLLATE=utf8mb4_unicode_ci AUTO_INCREMENT=10;\n\nCREATE TABLE `database_esempio`.`RigaOrdine` (\n    `NumeroRiga` INTEGER NOT NULL,\n    `Quantita` INTEGER NULL,\n    `ordine_NumeroOrdine` INTEGER NOT NULL,\n    CONSTRAINT `PK_dfc6863533066f3cdbf76eb1` PRIMARY KEY (`NumeroRiga`, `ordine_NumeroOrdine`)\n) ENGINE=InnoDB ROW_FORMAT=DYNAMIC DEFAULT CHARACTER SET=utf8mb4 COLLATE=utf8mb4_unicode_ci;\n\nALTER TABLE `database_esempio`.`RigaOrdine` ADD CONSTRAINT `FK_18ee5e61c535696ab4910299` FOREIGN KEY (`ordine_NumeroOrdine`) REFERENCES `database_esempio`.`Ordine` (`NumeroOrdine`);\n",
